# Copy to .env (read by docker compose and by `bun run dev` / `bun run start`).

# --- Database --------------------------------------------------------------
# Without DATABASE_URL, OpenRive runs an embedded PostgreSQL inside the data folder.
# DATABASE_URL=postgres://openrive:openrive@localhost:5432/openrive
# OPENRIVE_DATA_DIR=/var/lib/openrive
# OPENRIVE_DB_SSL=true          # force TLS (also enabled by ?sslmode=require)
# OPENRIVE_DB_SSL_CA=           # inline PEM CA for private PostgreSQL certificates
# OPENRIVE_ALLOW_INSECURE_INTERNAL_SERVICES=false # explicit private-network-only escape hatch
# OPENRIVE_DB_POOL=10           # max connections
# OPENRIVE_REDIS_URL=redis://localhost:6379 # optional distributed rate limits/locks
# OPENRIVE_EDITION=local              # local, self_hosted, or cloud

# --- Cloud object storage --------------------------------------------------
# Required only for OPENRIVE_EDITION=cloud. The same variables work with S3,
# R2, MinIO, or another S3-compatible provider.
# OPENRIVE_STORAGE_ENDPOINT=https://s3.example.com
# OPENRIVE_STORAGE_REGION=us-east-1
# OPENRIVE_STORAGE_BUCKET=openrive
# OPENRIVE_STORAGE_ACCESS_KEY_ID=...
# OPENRIVE_STORAGE_SECRET_ACCESS_KEY=...
# OPENRIVE_STORAGE_FORCE_PATH_STYLE=false  # true for MinIO
# MINIO_ROOT_USER=...                     # cloud Compose initializer only
# MINIO_ROOT_PASSWORD=...                 # cloud Compose initializer only

# Used by docker-compose.yml for its bundled PostgreSQL
# POSTGRES_USER=openrive
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=openrive

# --- Accounts --------------------------------------------------------------
# OPENRIVE_AUTH=auto            # auto (sign-in when DATABASE_URL is set), on, off
# OPENRIVE_SIGNUP=first         # who may use the sign-up page: open, first, off
# OPENRIVE_SESSION_DAYS=30
# OPENRIVE_AUTH_SECRET=         # 32+ chars; generated and stored when unset
# OPENRIVE_TRUSTED_ORIGINS=     # comma-separated origins; defaults to OPENRIVE_URL

# --- Access ----------------------------------------------------------------
# Require a password (HTTP Basic auth, any user name) for every request.
# Leave empty for local, login-free use.
# OPENRIVE_ACCESS_TOKEN=change-me

# --- Server & tools --------------------------------------------------------
# OPENRIVE_TAG=latest           # image tag: latest (newest build), 0.0.6, or a commit
# OPENRIVE_PORT=3000            # host port published by docker compose
# PORT=3000                     # port used by the app and `openrive serve`
# OPENRIVE_URL=http://localhost:3000 # use the public HTTPS URL in production
# OPENRIVE_USER=Admin           # default owner for CLI/MCP created files
# OPENRIVE_MCP_STATELESS=auto   # cloud defaults to replica-safe stateless HTTP MCP
