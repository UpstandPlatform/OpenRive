# Copy to .env (read by `docker compose`, `npm run dev` and `npm start`) to configure OpenRive.

# --- Storage ---------------------------------------------------------------
# Default: files in ./data (or OPENRIVE_DATA_DIR).
# OPENRIVE_DATA_DIR=/var/lib/openrive

# Set a PostgreSQL URL to store users and projects in Postgres instead.
# DATABASE_URL=postgres://openrive:openrive@localhost:5432/openrive
# OPENRIVE_DB_SSL=true          # force TLS (also enabled by ?sslmode=require)
# OPENRIVE_DB_POOL=10           # max connections

# Used by docker-compose.yml for its bundled Postgres
# POSTGRES_USER=openrive
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=openrive

# --- Access ----------------------------------------------------------------
# Require a password (HTTP Basic auth, any user name) for every request.
# Leave empty for local, login-free use.
# OPENRIVE_ACCESS_TOKEN=change-me

# --- Server & tools --------------------------------------------------------
# Host port published by docker compose
# OPENRIVE_PORT=3000
# Port used by `openrive serve` and in editor links printed by tools
# PORT=3000
# Default owner for files created by the CLI / MCP tools (user id or name)
# OPENRIVE_USER=Admin
