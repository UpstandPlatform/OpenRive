{
  "name": "openrive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.2",
      "@types/node": "^20.19.9",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.3",
      "lucide-react": "^1.47.0",
      "nanoid": "^6.0.1",
      "pg": "^8.23.0",
      "@types/pg": "^8.23.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "typescript": "^5.9.3",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build -F @openrive/web",
    "start": "turbo run start -F @openrive/web",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "bun scripts/roundtrip.test.ts && bun scripts/svg.test.ts",
    "test:corpus": "bun scripts/corpus.test.ts",
    "db:generate": "bun run --cwd packages/db drizzle-kit generate && bun scripts/embed-migrations.ts",
    "db:migrate": "bun run --cwd packages/db drizzle-kit migrate",
    "db:studio": "bun run --cwd packages/db drizzle-kit studio",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "cli": "bun apps/cli/src/index.ts",
    "mcp": "bun apps/cli/src/mcp-server.ts",
    "desktop": "bun run --cwd apps/desktop dev",
    "wiki": "bun scripts/build-wiki.mjs",
    "test:mcp": "bun scripts/mcp-smoke.test.ts",
    "build:desktop": "bun run --cwd apps/desktop build"
  },
  "devDependencies": {
    "@openrive/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "@openrive/db": "workspace:*",
    "@openrive/rive": "workspace:*",
    "@openrive/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
